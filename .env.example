# Place real values in the secret manager.
# Never commit this file with real credentials.
GRAFANA_ADMIN_USER=platform-admin
KEYCLOAK_ISSUER=https://sso.internal.example/realms/observability
S3_ENDPOINT=https://object-storage.internal.example
S3_BUCKET_METRICS=observability-metrics
S3_BUCKET_LOGS=observability-logs
S3_BUCKET_TRACES=observability-traces
DEFAULT_RETENTION_DAYS=30
PLATFORM_ALERT_EMAIL=observability-oncall@example.com

# 1 machine telemetry credentials (one Bearer token per INSTANCE:
# 1 credential -> 1 pipeline; <company>_<project>).
# Generate with: openssl rand -hex 32
# The gateway refuses to start if any are empty. Never commit real tokens.
KEVE_UBIX_OTEL_TOKEN=changeme-keve_ubix-token
KEVE_DIGIFLOW_OTEL_TOKEN=changeme-keve_digiflow-token
BCI_UBIX_OTEL_TOKEN=changeme-bci_ubix-token
BCI_DIGIFLOW_OTEL_TOKEN=changeme-bci_digiflow-token
KEYCLOAK_GRAFANA_CLIENT_SECRET=changeme-keycloak-grafana-client-secret
