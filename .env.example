# Place real values in the secret manager.
# Never commit this file with real credentials.
GRAFANA_ADMIN_USER=platform-admin
KEYCLOAK_ISSUER=https://sso.internal.example/realms/observability
S3_ENDPOINT=https://object-storage.internal.example
S3_BUCKET_METRICS=observability-metrics
S3_BUCKET_LOGS=observability-logs
S3_BUCKET_TRACES=observability-traces
DEFAULT_RETENTION_DAYS=30
PLATFORM_ALERT_EMAIL=observability-oncall@example.com
