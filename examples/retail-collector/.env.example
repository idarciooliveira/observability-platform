# Copy to .env and fill in: cp .env.example .env
# DIGIFLOW_OTEL_TOKEN must match DIGIFLOW_OTEL_TOKEN in observability-platform/.env
POSTGRES_DB=retail_orders
POSTGRES_USER=retail_orders
POSTGRES_PASSWORD=change-me
RETAIL_API_PORT=8084
POSTGRES_PORT=5434
ENV=dev

# App -> local collector only (no token on this leg).
OTEL_EXPORTER_OTLP_ENDPOINT=http://retail-collector:4317

# Collector -> platform gateway (compose.local.yml via Docker internal).
# The collector injects this as Authorization: Bearer on the platform leg.
DIGIFLOW_OTEL_TOKEN=change-me-digiflow-token

# Fault injection. 0/0 = off.
CHAOS_LATENCY_MS=0
CHAOS_FAIL_RATE=0
