# Variant B env (bci_digiflow): docker compose -f docker-compose.bci.yml --env-file .env.bci up -d
POSTGRES_DB=retail_orders
POSTGRES_USER=retail_orders
POSTGRES_PASSWORD=1234
RETAIL_API_PORT=8094
POSTGRES_PORT=5444
ENV=dev
OTEL_EXPORTER_OTLP_ENDPOINT=http://retail-collector:4317
BCI_DIGIFLOW_OTEL_TOKEN=change-me-bci-digiflow-token
CHAOS_LATENCY_MS=0
CHAOS_FAIL_RATE=0
