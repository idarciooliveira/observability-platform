# Variant A env (keve_digiflow): docker compose up reads .env by default.
# Committed with a placeholder: real tokens live in the ignored .env /
# secret manager. up.sh exports the platform tokens so gateway and clients
# agree even when this file holds placeholders.
POSTGRES_DB=retail_orders
POSTGRES_USER=retail_orders
POSTGRES_PASSWORD=change-me
RETAIL_API_PORT=8084
POSTGRES_PORT=5434
ENV=dev
OTEL_EXPORTER_OTLP_ENDPOINT=http://retail-collector:4317
KEVE_DIGIFLOW_OTEL_TOKEN=change-me-keve-digiflow-token
CHAOS_LATENCY_MS=0
CHAOS_FAIL_RATE=0
