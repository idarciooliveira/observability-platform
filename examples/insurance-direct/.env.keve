# Variant A env (keve_ubix): docker compose up reads .env by default.
# Committed with a placeholder: real tokens live in the ignored .env /
# secret manager. up.sh exports the platform tokens so gateway and clients
# agree even when this file holds placeholders.
POSTGRES_DB=insurance_db
POSTGRES_USER=insurance_user
POSTGRES_PASSWORD=change-me
INSURANCE_API_PORT=8083
RISK_SERVICE_PORT=8082
POSTGRES_PORT=5433
ENV=dev
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
KEVE_UBIX_OTEL_TOKEN=change-me-keve-ubix-token
CHAOS_LATENCY_MS=0
CHAOS_REJECT_RATE=0
