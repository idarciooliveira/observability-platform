# Variant B env (bci_ubix): docker compose -f docker-compose.bci.yml --env-file .env.bci up -d
POSTGRES_DB=insurance_db
POSTGRES_USER=insurance_user
POSTGRES_PASSWORD=1234
INSURANCE_API_PORT=8093
RISK_SERVICE_PORT=8092
POSTGRES_PORT=5443
ENV=dev
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
BCI_UBIX_OTEL_TOKEN=change-me-bci-ubix-token
CHAOS_LATENCY_MS=0
CHAOS_REJECT_RATE=0
