# Copy to .env and fill in: cp .env.example .env
# Variant A (default compose file): KEVE_UBIX_OTEL_TOKEN must match
# KEVE_UBIX_OTEL_TOKEN in observability-platform/.env
# (the platform gateway authenticates this instance and stores it as
# tenant.id=keve + project.id=ubix).
# Variant B (docker-compose.bci.yml --env-file .env.bci): same with BCI_UBIX.
POSTGRES_DB=insurance_db
POSTGRES_USER=insurance_user
POSTGRES_PASSWORD=change-me
INSURANCE_API_PORT=8083
RISK_SERVICE_PORT=8082
POSTGRES_PORT=5433
ENV=dev

# Platform ingest: compose.local.yml gateway via Docker internal (OTLP/HTTP only).
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
KEVE_UBIX_OTEL_TOKEN=change-me-keve-ubix-token

# Fault injection (risk-service). 0/0 = off.
CHAOS_LATENCY_MS=0
CHAOS_REJECT_RATE=0
